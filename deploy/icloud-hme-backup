#!/usr/bin/env bash
set -Eeuo pipefail
# Share the operator lock with deployments. The Python snapshot also holds the
# application's data-root lock, preventing a concurrent manual service start.
exec 9>/run/lock/icloud-hme-operations.lock
flock -w 300 9
was_active=0
if systemctl is-active --quiet icloud-hme.service; then
    was_active=1
fi
restart_service() {
    if [[ "$was_active" == 1 ]]; then
        systemctl start icloud-hme.service
    fi
}
trap restart_service EXIT
if [[ "$was_active" == 1 ]]; then
    systemctl stop icloud-hme.service
fi
/root/iCloud/.venv/bin/python /root/iCloud/ops/backup.py --verified-backup
